HloModule stats

fused {
  p0 = f32[10]{0} parameter(0)
  p1 = f32[10]{0} parameter(1)
  ROOT m = f32[10]{0} multiply(p0, p1), statistics={visualizing_index=0,stat-0=95}
}

fused2 {
  q0 = f32[10]{0} parameter(0)
  ROOT n = f32[10]{0} negate(q0)
}

ENTRY comp {
  a = f32[10]{0} parameter(0), statistics={visualizing_index=0,stat-0=0}
  b = f32[10]{0} parameter(1), statistics={visualizing_index=1,stat-0=5,stat-1=65}
  f = f32[10]{0} fusion(a, b), kind=kLoop, calls=fused, statistics={visualizing_index=0,stat-0=33}
  g = f32[10]{0} fusion(f), kind=kLoop, calls=fused2
  ROOT r = f32[10]{0} add(f, g), statistics={visualizing_index=0,stat-0=100}
}
